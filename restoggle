#!/data/data/com.termux/files/usr/bin/bash
# restoggle - force FLIPX_SIZE only while Termux:X11 is in the foreground;
#             native phone resolution for everything else.
# ADB target is auto-detected every loop (wireless port changes each restart).
FLIPX_SIZE="${FLIPX_SIZE:-1080x1920}"
FLIPX_DENSITY="${FLIPX_DENSITY:-190}"
source "$HOME/adb_common.sh" 2>/dev/null || true
state="x11"   # guistart already forced 16:9 before launching us

while true; do
    if declare -F pick_adb_device >/dev/null 2>&1; then
        pick_adb_device 2>/dev/null || true
    else
        ADB_TARGET=""
        ADB_SHELL="adb shell"
    fi

    # adb down / disconnected: don't touch resolution, retry shortly
    if [ -z "${ADB_TARGET:-}" ]; then
        sleep 2
        continue
    fi

    # External monitor connected: desktop mode owns the layout, stay out
    if $ADB_SHELL dumpsys display 2>/dev/null | grep -q 'type=EXTERNAL[^}]*displayId='; then
        sleep 5
        continue
    fi

    fg=$($ADB_SHELL "dumpsys window displays | grep mCurrentFocus" 2>/dev/null)

    if [ -z "$fg" ]; then
        sleep 2
        continue
    fi

    case "$fg" in
        *com.termux.x11*) want="x11" ;;
        *)                want="other" ;;
    esac

    if [ "$want" != "$state" ]; then
        if [ "$want" = "x11" ]; then
            $ADB_SHELL "wm size $FLIPX_SIZE; wm density $FLIPX_DENSITY" >/dev/null 2>&1
        else
            for d in "" " -d 0" " -d 1" " -d 6"; do
                $ADB_SHELL "wm size reset$d" >/dev/null 2>&1 || true
                $ADB_SHELL "wm density reset$d" >/dev/null 2>&1 || true
            done
        fi
        state="$want"
    fi
    sleep 1
done
